# ====================================================
# Makefile.win (Windows w64devkit用 - 完全固定版)
# ====================================================


NAME        := a.out.exe
OBJDIR_WIN  := obj_win

CC          := C:/raylib/w64devkit/bin/gcc.exe

RAYLIB_DIR  := C:/raylib/w64devkit

CFLAGS      := -g -Wall -Wextra -std=c99 -pedantic-errors -MMD -MP -I$(RAYLIB_DIR)/include
LIBS        := -L$(RAYLIB_DIR)/lib -lraylib -lopengl32 -lgdi32 -lwinmm


SRCS        := $(wildcard *.c)
OBJS_WIN    := $(SRCS:%.c=$(OBJDIR_WIN)/%.o)
DEPS_WIN    := $(OBJS_WIN:.o=.d)

.PHONY: all

all: $(NAME)

# リンク工程（.exe の作成）
$(NAME): $(OBJS_WIN)
	export PATH="$(W64DEVKIT_BIN):$$PATH" && $(CC) $(CFLAGS) -o $@ $^ $(LIBS)
	@chmod 755 $@

	@echo "--- Windows Nativeの $(NAME) を実行権限付きで作成しました ---"

# コンパイル工程（.o の作成）★ここを以下のように修復します！
$(OBJDIR_WIN)/%.o: %.c
	@mkdir -p $(dir $@)
	export PATH="$(W64DEVKIT_BIN):$$PATH" && $(CC) $(CFLAGS) -c $< -o $@

-include $(DEPS_WIN)
